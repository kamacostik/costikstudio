{
  "name": "CostikStudio - Sumopod Paid Webhook With Token",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "costikstudio-sumopod-paid",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Sumopod Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "costikstudio-sumopod-paid"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-webhook-token']}}",
              "rightValue": "={{$env.SUMOPOD_WEBHOOK_TOKEN}}",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "verify-webhook-token",
      "name": "Verify Webhook Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"leftValue": "={{$json.body.event_type}}", "rightValue": "payment.completed", "operator": {"type": "string", "operation": "equals"}},
            {"leftValue": "={{$json.body.data?.status}}", "rightValue": "completed", "operator": {"type": "string", "operation": "equals"}}
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "is-paid",
      "name": "Is Paid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/apply_paid_topup_order",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
            {"name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"target_external_reference\": \"{{$json.body.data.order_id}}\",\n  \"provider_order_id\": \"{{$json.body.data.payment_id}}\",\n  \"raw_payload\": {\n    \"event_type\": \"{{$json.body.event_type}}\",\n    \"payment_id\": \"{{$json.body.data.payment_id}}\",\n    \"order_id\": \"{{$json.body.data.order_id}}\",\n    \"amount\": {{$json.body.data.amount}},\n    \"fee\": {{$json.body.data.fee}},\n    \"net_amount\": {{$json.body.data.net_amount}},\n    \"status\": \"{{$json.body.data.status}}\",\n    \"payment_method\": \"{{$json.body.data.payment_method}}\",\n    \"completed_at\": \"{{$json.body.data.completed_at}}\"\n  }\n}",
        "options": {}
      },
      "id": "apply-paid-topup",
      "name": "Apply Paid Top Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, -180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"message\": \"processed\"}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1020, -180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"message\": \"ignored - not completed\"}",
        "options": {}
      },
      "id": "respond-ignored",
      "name": "Respond Ignored",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={\"ok\": false, \"message\": \"invalid webhook token\"}",
        "options": {}
      },
      "id": "respond-unauthorized",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [500, 140]
    }
  ],
  "connections": {
    "Sumopod Webhook": {"main": [[{"node": "Verify Webhook Token", "type": "main", "index": 0}]]},
    "Verify Webhook Token": {"main": [[{"node": "Is Paid?", "type": "main", "index": 0}], [{"node": "Respond Unauthorized", "type": "main", "index": 0}]]},
    "Is Paid?": {"main": [[{"node": "Apply Paid Top Up", "type": "main", "index": 0}], [{"node": "Respond Ignored", "type": "main", "index": 0}]]},
    "Apply Paid Top Up": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
